{
  "model": {
    "name": "FM9G-4B",
    "path": "${MODEL_DIR}",
    "layers": 62,
    "hidden_size": 2560,
    "num_attention_heads": 40,
    "num_query_groups": 4,
    "ffn_hidden_size": 6400,
    "vocab_size": 73448,
    "smoke": false,
    "tie_word_embeddings": true
  },
  "task": {
    "save_checkpoint": false,
    "collect_step_metrics": true,
    "profile_enabled": false,
