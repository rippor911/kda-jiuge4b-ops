    "seq_length": 512,
    "micro_batch_size": 1,
    "global_batch_size": 16,
    "train_iters": 15,
    "lr": 1e-05,
    "save_interval": 15,
    "save": "${OUTPUT_DIR}/checkpoints",
    "load": "",
